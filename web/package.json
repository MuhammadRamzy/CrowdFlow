{
  "name": "crowdflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine": "cd ../engine/cf-wasm && wasm-pack build --target web --out-dir ../../web/src/engine --no-typescript --release",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
